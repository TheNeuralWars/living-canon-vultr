PORT=3000
# mock (default, offline) | live (Vultr Serverless Inference)
VULTR_INFERENCE_MODE=mock
VULTR_INFERENCE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=replace-me
VULTR_INFERENCE_MODEL=llama-3.3-70b-instruct-fp8
# local (in-process, same policy) | docker (one-shot --network=none containers)
SANDBOX_MODE=local
SANDBOX_IMAGE=alpine:3.20
